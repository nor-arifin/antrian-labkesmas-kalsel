{
  "name": "antrian-labkesda",
  "version": "1.0.0",
  "description": "Sistem Antrian Digital - Labkesda Kalteng",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "setup": "node server/db/schema.js && node server/db/seed.js",
    "kiosk": "concurrently -k -n server,client,electron -c blue,green,magenta \"node server/index.js\" \"vite\" \"wait-on http://localhost:3080 && cd electron && electron .\"",
    "kiosk:server": "node server/index.js",
    "kiosk:client": "vite",
    "kiosk:electron": "wait-on http://localhost:3080 && cd electron && electron ."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "escpos-builder-ts": "^0.3.1",
    "express": "^4.21.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.0",
    "socket.io": "^4.8.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "socket.io-client": "^4.8.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.1"
  }
}
