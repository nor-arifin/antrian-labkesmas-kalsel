{
  "name": "antrian-kiosk",
  "version": "1.0.0",
  "description": "Antrian Labkesprov Kalsel - Kiosk Mode (installer Windows)",
  "main": "main.js",
  "author": "Labkesda Kalsel",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "id.labkes.kalsel.antrian",
    "productName": "Antrian Labkesda Kalsel Kiosk",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Antrian Kiosk",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  }
}
